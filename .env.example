# Supabase project (see .env for the actual values used locally)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Canonical public origin used to build absolute URLs that must be identical
# during SSR and after hydration (canonical link, Open Graph, Twitter Card,
# JSON-LD -- see src/lib/seo.ts). Leave unset locally: it already falls back
# to https://saovia.net, which is fine for local SEO-tag testing since search
# engines never see a dev build anyway. Set it explicitly in the production
# hosting environment once the app is actually deployed at https://saovia.net.
#
# Everything else that needs the app's own URL (Supabase Auth email
# redirects, driver activation links, the tenant QR code) reads
# window.location.origin instead and already adapts automatically between
# localhost and production -- no env var needed there.
VITE_SITE_URL=https://saovia.net
